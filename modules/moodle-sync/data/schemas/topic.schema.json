{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sources_index": {
      "const": "sources/index.json"
    },
    "derived_index": {
      "const": "derived/index.json"
    }
  },
  "required": [
    "schema",
    "subject_id",
    "topic_id",
    "title",
    "sources_index",
    "derived_index"
  ]
}
