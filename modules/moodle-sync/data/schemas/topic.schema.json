{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "topic.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sources_index": {
      "const": "sources/index.json"
    },
    "derived_index": {
      "const": "derived/index.json"
    },
    "origin": {
      "enum": [
        "study",
        "moodle"
      ]
    },
    "course_variant": {
      "type": "string",
      "pattern": "^JU3[A-Z]*$"
    },
    "section_order": {
      "type": "integer",
      "minimum": 0
    },
    "available": {
      "type": "boolean"
    },
    "listed_current": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "subject_id",
    "topic_id",
    "title",
    "sources_index",
    "derived_index"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "moodle"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "origin",
          "course_variant",
          "section_order",
          "available",
          "listed_current"
        ],
        "properties": {
          "topic_id": {
            "pattern": "^section-[a-f0-9]{32}$"
          }
        }
      }
    }
  ]
}
