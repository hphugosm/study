{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derived.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,59}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,59}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "enum": [
              "extract",
              "notes",
              "flashcards",
              "quiz",
              "other"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^data/subjects/[a-z][a-z0-9-]*/topics/[a-z][a-z0-9-]*/derived/[a-z][a-z0-9-]*/[a-zA-Z0-9][a-zA-Z0-9_-]*\\.(md|json|pdf|txt|html|svg|png|webp)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "sha256"
              ]
            }
          },
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "path",
          "sha256",
          "source_refs",
          "review_status"
        ]
      }
    }
  },
  "required": [
    "schema",
    "subject_id",
    "topic_id",
    "artifacts"
  ]
}
