    {
      "id": "dukazove-reakce",
      "title": "Co ukáže ninhydrin a co Biuretova reakce",
      "source_refs": [
        {
          "id": "91c4bc78dcd80b3cd48cfcb08b4c94d48d7060217dca29ec18fb9ac8bada0843",
