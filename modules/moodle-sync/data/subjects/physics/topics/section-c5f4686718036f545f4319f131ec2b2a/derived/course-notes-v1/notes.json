  "lessons": [
    {
      "id": "disperze",
      "title": "Jedno bílé světlo, různé barevné složky",
      "source_refs": [
        {
          "id": "f41f138ae053d4e66f2f9f45177f0a63ef2de7a01c1f2565d722309945025c7e",
          "sha256": "87143de81a86777efe9f065b98316ce3b8fee65c4e83bc4ef74e38f54fb30b14",
          "page": 1
        }
      ],
      "blocks": [
        {
          "type": "paragraph",
          "text": "Disperze je rozklad bílého světla při lomu na barevné složky. V modelu použitém v pracovním listu závisí index prostředí na frekvenci: pro fialovou složku je větší než pro červenou.",
          "source_refs": [
            {
              "id": "f41f138ae053d4e66f2f9f45177f0a63ef2de7a01c1f2565d722309945025c7e",
              "sha256": "87143de81a86777efe9f065b98316ce3b8fee65c4e83bc4ef74e38f54fb30b14",
              "page": 1
            }
          ]
        },
        {
          "type": "list",
          "items": [
            "Červená složka má v uvedeném spektru nejmenší index a láme se nejméně.",
            "Fialová složka má největší index a láme se nejvíce.",
            "Pořadí v listu: červená, oranžová, žlutá, zelená, modrá, fialová."
          ],
          "source_refs": [
            {
              "id": "f41f138ae053d4e66f2f9f45177f0a63ef2de7a01c1f2565d722309945025c7e",
              "sha256": "87143de81a86777efe9f065b98316ce3b8fee65c4e83bc4ef74e38f54fb30b14",
              "page": 1
            }
          ]
        },
        {
          "type": "callout",
          "tone": "key",
          "text": "Nezaměňuj rozklad na barvy s „obarvením“ jednoho paprsku. Bílé světlo obsahuje složky, které se na rozhraní odkloní různě.",
          "source_refs": [
            {
              "id": "f41f138ae053d4e66f2f9f45177f0a63ef2de7a01c1f2565d722309945025c7e",
              "sha256": "87143de81a86777efe9f065b98316ce3b8fee65c4e83bc4ef74e38f54fb30b14",
              "page": 1
            }
          ]
        }
      ],
      "images": [
        {
          "src": "https://github.com/hphugosm/study/releases/download/studylo-learning-v1/9ed3912f0700256be3870cfdbf42bdd2f6113bb04ebfd37f84fbbedf7bd4a940.webp",
          "alt": "Původní náčrt rozkladu bílého světla a pořadí spektra",
          "caption": "Disperze, původní pracovní list, strana 1.",
