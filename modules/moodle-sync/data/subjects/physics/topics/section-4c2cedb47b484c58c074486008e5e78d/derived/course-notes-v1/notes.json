      "source_refs": [
        {
          "id": "e6fd7857a973980519ae4cec71933d4adc74c30a745c15a469108746843df6da",
          "sha256": "d6b0ca24efb1fdc1d8623b9da32092cf8fb0c24a6aa5a5444d069a5286ef08df",
