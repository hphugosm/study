    {
      "id": "cytoskelet-a-srovnani",
      "title": "Cytoskelet a srovnání buněk",
      "source_refs": [
        {
          "id": "136a1514ad71f3c86ad4b95e37bfdf0b891f21244d1ecbf2b2ea76a6e5761f0d",
          "sha256": "9afe10ecac96943c93ea07b736bba0987fd2e24f31b7ef7589e5e26d074da3f9",
