    {
      "id": "card-3",
      "front": "Je 16 let samo o sobě plná svéprávnost?",
      "back": "Ne. Dodaný § 37 řeší podmínky přiznání soudem.",
      "source_refs": [
        {
          "id": "84f66e9e244db7a5b15eaa098b4aab442b96ed6639a4ad2a63f9f63d5df6ee42",
