  "lessons": [
    {
      "id": "landmark-clues",
      "title": "Read a clue before placing a label",
      "source_refs": [
        {
          "id": "a10c8fddd17a0d0789b52388a6c6fc91c7fc3edcb44689841cf192bc09dfcd40",
          "sha256": "19873d058f06c4a4ae2118dd327ddb3b778723152dc229618855f6aef342a9c5",
          "locator": "illustrated worksheet image"
        }
      ],
      "blocks": [
        {
          "type": "paragraph",
          "text": "The worksheet combines a US map, pictured landmarks, a lettered list of places and fourteen numbered clues. Match the meaning of a clue to a listed place, then use the map to check the location. Several clues refer to cities or landmarks rather than entire states.",
          "source_refs": [
            {
              "id": "a10c8fddd17a0d0789b52388a6c6fc91c7fc3edcb44689841cf192bc09dfcd40",
              "sha256": "19873d058f06c4a4ae2118dd327ddb3b778723152dc229618855f6aef342a9c5",
              "locator": "illustrated worksheet image"
            }
          ]
        },
        {
          "type": "list",
          "items": [
            "The Space Needle clue points to Washington State.",
            "The Liberty Bell clue connects the landmark with Philadelphia, Pennsylvania.",
            "The Las Vegas clue describes gambling and very quick marriages.",
            "Alaska and Hawaii are drawn separately from the main mainland map."
          ],
          "source_refs": [
            {
              "id": "a10c8fddd17a0d0789b52388a6c6fc91c7fc3edcb44689841cf192bc09dfcd40",
              "sha256": "19873d058f06c4a4ae2118dd327ddb3b778723152dc229618855f6aef342a9c5",
              "locator": "illustrated worksheet image"
            }
          ]
        },
        {
          "type": "callout",
          "tone": "key",
          "text": "The image includes the answers to some clues in its wording. Use those explicit links first; do not invent extra locations.",
          "source_refs": [
            {
              "id": "a10c8fddd17a0d0789b52388a6c6fc91c7fc3edcb44689841cf192bc09dfcd40",
              "sha256": "19873d058f06c4a4ae2118dd327ddb3b778723152dc229618855f6aef342a9c5",
              "locator": "illustrated worksheet image"
            }
          ]
        }
