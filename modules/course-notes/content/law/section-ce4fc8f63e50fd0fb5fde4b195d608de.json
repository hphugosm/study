  "lessons": [
    {
      "id": "two-sources",
      "title": "Common law and statute law",
      "source_refs": [
        {
          "id": "83e63af86527c461e899099a2f48de3efedc3e480521ef210010a1c1922e6792",
          "sha256": "48c98de26d06ad13cd76c3d8d1df74f93e2208b0d5dd1597bb5575580a0b1370",
          "page": 2
        },
        {
          "id": "e0f9c3f64511c0ea8f72be846fd06b97c86c60fe861638e8239cef546ddc235c",
          "sha256": "28c8fc5e36cc9c545dcbfa61b12abf89f48f29f66271f3593a544b8545fd3cca",
          "locator": "Ancient Rules and Laws questions"
        }
      ],
      "blocks": [
        {
          "type": "paragraph",
          "text": "The presentation distinguishes law shaped by customs and judicial precedent from statutes passed by a legislature. Precedent connects a later dispute to the treatment of a similar earlier case; the relevant link is the legal reasoning, not merely that both disputes happened in court.",
          "source_refs": [
            {
              "id": "83e63af86527c461e899099a2f48de3efedc3e480521ef210010a1c1922e6792",
              "sha256": "48c98de26d06ad13cd76c3d8d1df74f93e2208b0d5dd1597bb5575580a0b1370",
              "page": 2
            }
          ]
        },
        {
          "type": "callout",
          "tone": "key",
          "text": "Use “statute law”. The final vocabulary slide misspells it “Statue Law”; the legal category is already correctly named on slide 2.",
          "source_refs": [
            {
              "id": "83e63af86527c461e899099a2f48de3efedc3e480521ef210010a1c1922e6792",
              "sha256": "48c98de26d06ad13cd76c3d8d1df74f93e2208b0d5dd1597bb5575580a0b1370",
              "page": 2
            }
          ]
        }
      ],
      "comparison": {
        "columns": [
          "Common law",
          "Statute law"
        ],
        "rows": [
          {
            "label": "Basis in this presentation",
            "values": [
              "Custom and judicial precedent",
              "Enactment by a legislature"
            ]
          },
          {
            "label": "Study question",
            "values": [
              "How was a comparable dispute decided?",
              "What rule did the legislature enact?"
            ]
          }
        ]
      }
    },
    {
