  "questions": [
    {
      "id": "question-1",
      "prompt": "Which basis does the presentation assign to common law?",
      "options": [
        "Only executive orders",
        "Customs and judicial precedent",
        "Only a written constitution"
      ],
      "answer": 1,
      "explanation": "Common law is contrasted with legislative enactment.",
      "source_refs": [
