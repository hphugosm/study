              "sha256": "96ad81d2b9a1093bf7d47ad6b2cb36faf5543853086d633e657d8bb0aca09dd2",
              "page": 11
            }
          ],
          "source_media": "extracted/96ad81d2b9a1093bf7d47ad6b2cb36faf5543853086d633e657d8bb0aca09dd2/media/slide-011-preview.png",
          "width": 1400,
