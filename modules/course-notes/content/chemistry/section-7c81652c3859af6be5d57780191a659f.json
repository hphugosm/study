    {
      "id": "pepsin",
      "front": "Který enzym zahajuje popsané trávení bílkovin v žaludku?",
      "back": "Pepsin, který vzniká z pepsinogenu v kyselém prostředí.",
      "source_refs": [
        {
          "id": "51c4f61a61a4b9efe351fd908502d9cbabfca3d2a64b19f076fd773b327ba9e6",
          "sha256": "e70bf0ff2a041ee2f3ce08db1799c3eccd9503e6469f5fe51f7e2d8e61a4f348",
          "page": 1
        }
      ]
    },
    {
      "id": "urea-organy",
      "front": "Kde se močovina tvoří a kudy se vylučuje?",
      "back": "Tvoří se hlavně v játrech a vylučuje se ledvinami do moči.",
      "source_refs": [
        {
