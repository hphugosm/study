    {
      "id": "c-analyt",
      "front": "Co je analyt?",
      "back": "Stanovovaná složka, tedy látka nebo částice, jejíž množství či přítomnost určujeme.",
      "source_refs": [
        {
          "id": "dc4b3b0397e4a85787269460025c0502dc4488ae9f3e1ba887230b261c4e560e",
