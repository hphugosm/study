{
  "name": "study-unified",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet place for school. Calendar, Law and Biology in one app.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:calendar": "node scripts/check-calendar-sync.mjs",
    "test": "node --test tests/*.test.cjs modules/biology/tests/*.test.cjs modules/course-notes/tests/*.test.cjs modules/biology-muscles/tests/*.test.mjs",
    "prepare:courses": "node scripts/generate-course-catalog.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": { "@playwright/test": "1.64.1" },
  "engines": { "node": ">=22" }
}
